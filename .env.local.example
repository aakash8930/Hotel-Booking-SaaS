# Local development environment variables
# This file is gitignored and takes precedence over .env

# Database (Docker Compose defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_booking_dev"

# Redis (Docker Compose defaults)
REDIS_URL="redis://localhost:6379"

# JWT secrets (generate with: openssl rand -hex 32)
JWT_SECRET="dev-secret-change-me-in-production-at-least-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# App URLs (local development)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: PhonePe (for payment testing)
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX=""
PHONEPE_BASE_URL="https://api-preprod.phonepe.com/apis/pg-sandbox"
PHONEPE_REDIRECT_URL="http://localhost:3000/booking/payment-status"

# Optional: Cloudflare R2 (for file storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="hotel-photos"
R2_PUBLIC_URL=""

# Optional: Resend (for emails)
RESEND_API_KEY=""
EMAIL_FROM="bookings@localhost"

# Optional: Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
SENTRY_DSN=""
