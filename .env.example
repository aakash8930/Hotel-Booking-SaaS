# ──────────────────────────────────────────────
# Hotel Booking SaaS — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Neon or Supabase free-tier Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/hotel_booking_saas?sslmode=require"

# ── Redis ─────────────────────────────────────
# Upstash serverless Redis
REDIS_URL="redis://default:password@host:port"

# ── JWT Auth ──────────────────────────────────
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-to-another-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# ── PhonePe Payments ──────────────────────────
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX=""
PHONEPE_BASE_URL="https://api-preprod.phonepe.com/apis/pg-sandbox"
PHONEPE_REDIRECT_URL="http://localhost:3000/booking/payment-status"

# ── Cloudflare R2 (File Storage) ─────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="hotel-photos"
R2_PUBLIC_URL=""

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="bookings@yourdomain.com"

# ── AI (Gemini — free tier at aistudio.google.com/apikey) ────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ── App URLs ──────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Analytics & Error Tracking ────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
# Backend (NestJS) error tracking — free tier at sentry.io
SENTRY_DSN=""
# Frontend (Next.js) error tracking — NEXT_PUBLIC_ because a DSN is meant
# to ship in the client bundle (like a Stripe publishable key, not a secret)
NEXT_PUBLIC_SENTRY_DSN=""
