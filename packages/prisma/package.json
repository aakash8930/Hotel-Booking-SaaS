{
  "name": "@hbs/prisma",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "preinstall": "test -f .env || ln -sf ../../.env .env 2>/dev/null || true",
    "build": "tsc -p tsconfig.json",
    "generate": "pnpm exec prisma generate",
    "migrate": "pnpm exec prisma migrate dev",
    "migrate:deploy": "pnpm exec prisma migrate deploy",
    "push": "pnpm exec prisma db push",
    "studio": "pnpm exec prisma studio",
    "seed": "tsx prisma/seed.ts",
    "lint": "echo 'no lint for prisma package'"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
